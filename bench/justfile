# piecetab benchmark recipes
# Run from repo root: just bench/<recipe> (just runs this file from bench/)

import '../build.just'
MODULE := "bench"

default: all

# print the current benchmark summary table
all: (py "scripts/bench_summary.py")

# quick PT smoke run
smoke: root (c-build "bench_pt.c" "build/pt/pt_bench" "-I. -Ibench")
    mkdir -p results/pt
    ./build/pt/pt_bench --rounds 2 --iters 100 --json results/pt/pt_smoke.json

# run default SP benchmark
sp *args='': root (c-build "bench_sp.c" "build/sp/sp_bench" "-I. -Ibench" "-DSP_FANOUT=34 -DSP_MAX_LEVEL=16")
    mkdir -p results/sp
    ./build/sp/sp_bench {{ args }}

# quick SP smoke run
sp-smoke: root (c-build "bench_sp.c" "build/sp/sp_bench" "-I. -Ibench" "-DSP_FANOUT=34 -DSP_MAX_LEVEL=16")
    mkdir -p results/sp
    ./build/sp/sp_bench --rounds 2 --iters 100 --json results/sp/sp_smoke.json

# SP_FANOUT sweep
sp-sweep:
    bash scripts/bench_sweep_sp.sh

# SP confirmation sweep
sp-confirm:
    bash scripts/bench_confirm_sp.sh

# analyze SP confirmation results
sp-analyze: (py "scripts/analyze_sp_confirm.py")

# SP sparse confirmation sweep
sp-sparse-confirm:
    bash scripts/bench_sparse_confirm.sh

# analyze SP sparse confirmation results
sp-sparse-analyze: (py "scripts/analyze_sparse_confirm.py")

# plot SP sweep results
sp-plot: (py "scripts/plot_bench.py" "results/sp/sp_fanout_*.json" "--out" "reports/sp")

# run default LC benchmark
lc *args='': root (c-build "bench_lc.c" "build/lc/lc_bench" "-I. -Ibench" "-DLC_FANOUT=16 -DLC_LEAF_FANOUT=34 -DLC_MAX_LEVEL=21")
    mkdir -p results/lc
    ./build/lc/lc_bench {{ args }}

# quick LC smoke run
lc-smoke: root (c-build "bench_lc.c" "build/lc/lc_bench" "-I. -Ibench" "-DLC_FANOUT=16 -DLC_LEAF_FANOUT=34 -DLC_MAX_LEVEL=21")
    mkdir -p results/lc
    ./build/lc/lc_bench --rounds 2 --iters 100 --json results/lc/lc_smoke.json

# LC probe sweep
lc-probe:
    bash scripts/bench_lc_probe.sh

# plot LC probe results
lc-probe-plot: (py "scripts/plot_lc_probe3d.py")

# LC sweep (fanout or leaf)
lc-sweep *args='':
    bash scripts/bench_lc_sweep.sh {{ args }}

# analyze LC sweep results
lc-analyze *args='': (lc-sweep-analyze args)

# analyze LC sweep results (low-level alias)
lc-sweep-analyze *args='': (py "scripts/analyze_lc_sweep.py" args)

# LC confirmation sweep
lc-confirm:
    bash scripts/bench_lc_confirm.sh

# analyze LC confirmation results
lc-confirm-analyze: (py "scripts/analyze_lc_confirm.py")

# plot LC probe results
lc-plot: (py "scripts/plot_bench.py" "results/lc/probe/lc_f*_lf*.json" "--out" "reports/lc")

# PT_FANOUT sweep
pt-sweep:
    bash scripts/bench_sweep.sh

# PT confirmation sweep
pt-confirm:
    bash scripts/bench_confirm.sh

# plot PT sweep results
pt-plot: (py "scripts/plot_bench.py" "results/pt/pt_fanout_*.json" "--out" "reports/pt")

# full PT_FANOUT sweep (README-compatible aggregate)
sweep: pt-sweep

# focused multi-seed confirmation sweep (README-compatible aggregate)
confirm: pt-confirm

# plot JSON results (README-compatible aggregate)
plot: pt-plot

# remove benchmark build/results/reports
clean:
    rm -rf build results reports
