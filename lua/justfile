# lua bindings: build, test, coverage. CWD = lua/ (just lua/<recipe> sets it)
# run from repo root: just lua/<name> | just lua/<name>-cov | just lua/<name>-lines | just lua/clean

import '../build.just'

INCS := "-I. -I.."
LUAFLAGS := "-Wall -Wextra -Wconversion -Wno-sign-conversion -Werror -std=gnu99 -Wno-variadic-macros -Wno-array-bounds"
LDF := `if [ "$(uname)" = "Darwin" ]; then echo "-bundle -undefined dynamic_lookup"; else echo "-shared -fPIC"; fi`
LUA_INC := `
    if [ "$(uname)" = "Darwin" ]; then
        for d in /opt/homebrew/include/lua5.5 /opt/homebrew/include/lua5.4 \
            "$HOME/.lua/include" "$HOME/.lua/include/lua5.5" \
            "$HOME/.lua/include/lua5.4" ../.lua/include .lua/include \
            /usr/local/include /usr/local/include/lua5.5 \
            /usr/local/include/lua5.4 /usr/include/lua5.4; do
            [ -d "$d" ] && { echo "-I$d"; exit 0; }
        done
    else
        for d in ../.lua/include .lua/include "$HOME/.lua/include" \
            "$HOME/.lua/include/lua5.5" "$HOME/.lua/include/lua5.4" \
            /usr/local/include /usr/local/include/lua5.5 \
            /usr/local/include/lua5.4 /usr/include/lua5.4; do
            [ -d "$d" ] && { echo "-I$d"; exit 0; }
        done
    fi
    exit 0
`
LUAJIT_INC := `
    for d in ../.lua/include/luajit-2.1 .lua/include/luajit-2.1 \
        /opt/homebrew/include/luajit-2.1 /usr/include/luajit-2.1; do
        [ -d "$d" ] && { echo "-I$d"; exit 0; }
    done
    exit 0
`

build mod: (build-lua mod)
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUAJIT_INC }} -DNDEBUG -O2 {{ LDF }} -o luajit/{{ mod }}.so {{ mod }}.c

build-lua mod:
    mkdir -p luajit
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUA_INC }} -DNDEBUG -O2 {{ LDF }} -o {{ mod }}.so {{ mod }}.c

# debug + ASAN build of a binding module: `just lua/dbg spantree` then
# run with `lua -e 'package.cpath="./?.so;./spantree_asan.so;"..package.cpath'`
dbg mod:
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUA_INC }} -g -O0 -fno-omit-frame-pointer {{ LDF }} -o {{ mod }}.so {{ mod }}.c

run t *args='':
    lua tests/{{ t }}.lua {{ args }}
    luajit tests/{{ t }}.lua {{ args }}

pt *args='': (build "piecetab") (run "piecetab_test" args)
cg *args='': (build "cellgrid") (run "cellgrid_test" args)
tf *args='': (build "termfeed") (run "termfeed_test" args)
json *args='': (build "json") (run "json_test" args)
lsp *args='': (build "json") (run "lsp_test" args)
sp *args='': (build "spantree") (run "spantree_test" args)
# tree-sitter is optional; add it with `just lua/build-ts` for highlighting.
# Build the PUC Lua modules needed to run the editor demo (no tests).
deps: (build-lua "piecetab") (build-lua "cellgrid") (build-lua "termfeed") (build-lua "json") (build-lua "spantree")

# editor demo needs lua-utf8 rock (PUC Lua only); json.so is required
# by lsp.lua, which editor.lua loads
ed *args='': deps
    lua tests/editor_test.lua {{ args }}
# display integration tests: real terminal via tmux helper
# (needs tmux in PATH; json.so is required by lsp.lua in the session)
ed-tmux *args='': deps
    lua tests/editor_tmux_test.lua {{ args }}

TS_INC := "-I/opt/homebrew/include"
TS_LIB := "-L/opt/homebrew/lib -ltree-sitter"

ts-grammars *langs='c lua':
    ../misc/fetch_grammars.sh {{ langs }}

build-ts: ts-grammars
    mkdir -p luajit
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUA_INC }} {{ TS_INC }} -DNDEBUG -O2 -bundle -undefined dynamic_lookup -o treesitter.so treesitter.c {{ TS_LIB }}
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUAJIT_INC }} {{ TS_INC }} -DNDEBUG -O2 -bundle -undefined dynamic_lookup -o luajit/treesitter.so treesitter.c {{ TS_LIB }}

ts *args='': build-ts (run "treesitter_test" args)

# run every test suite (needs lua-utf8 rock, tmux, tree-sitter grammars)
test: pt cg tf json lsp ed ed-tmux ts sp

cov mod t:
    rm -f *.gcda luajit/*.gcda
    mkdir -p luajit
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUA_INC }} --coverage -g -O0 -bundle -undefined dynamic_lookup -o {{ mod }}.so {{ mod }}.c
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUAJIT_INC }} --coverage -g -O0 -bundle -undefined dynamic_lookup -o luajit/{{ mod }}.so {{ mod }}.c
    lua tests/{{ t }}.lua && luajit tests/{{ t }}.lua
    lcov --capture --directory . --base-directory . --rc branch_coverage=1 --output-file lua_coverage.info --ignore-errors mismatch
    lcov --extract lua_coverage.info '*/{{ mod }}.c' --rc branch_coverage=1 --output-file lcov.info
    @echo ""
    @echo "=== {{ mod }}.c coverage ==="
    lcov --list --rc branch_coverage=1 lcov.info

pt-cov: (cov "piecetab" "piecetab_test")
cg-cov: (cov "cellgrid" "cellgrid_test")
tf-cov: (cov "termfeed" "termfeed_test")
sp-cov: (cov "spantree" "spantree_test")

json-cov:
    rm -f *.gcda luajit/*.gcda
    mkdir -p luajit
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUA_INC }} --coverage -g -O0 -bundle -undefined dynamic_lookup -o json.so json.c
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUAJIT_INC }} --coverage -g -O0 -bundle -undefined dynamic_lookup -o luajit/json.so json.c
    lua tests/json_test.lua && luajit tests/json_test.lua
    lcov --capture --directory . --base-directory . --rc branch_coverage=1 --output-file lua_coverage.info --ignore-errors mismatch,inconsistent,unsupported
    lcov --extract lua_coverage.info '*/json.c' --rc branch_coverage=1 --output-file lcov.info --ignore-errors mismatch,inconsistent,unsupported
    lcov --remove lcov.info '*/yyjson/yyjson.c' --rc branch_coverage=1 --output-file lcov.info --ignore-errors mismatch,inconsistent,unsupported
    @echo ""
    @echo "=== json.c coverage ==="
    lcov --list --rc branch_coverage=1 lcov.info

ts-cov:
    rm -f *.gcda luajit/*.gcda
    mkdir -p luajit
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUA_INC }} {{ TS_INC }} --coverage -g -O0 -bundle -undefined dynamic_lookup -o treesitter.so treesitter.c {{ TS_LIB }}
    {{ CC }} {{ LUAFLAGS }} {{ INCS }} {{ LUAJIT_INC }} {{ TS_INC }} --coverage -g -O0 -bundle -undefined dynamic_lookup -o luajit/treesitter.so treesitter.c {{ TS_LIB }}
    lua tests/treesitter_test.lua && luajit tests/treesitter_test.lua
    lcov --capture --directory . --base-directory . --rc branch_coverage=1 --output-file lua_coverage.info --ignore-errors mismatch
    lcov --extract lua_coverage.info '*/treesitter.c' --rc branch_coverage=1 --output-file lcov.info
    @echo ""
    @echo "=== treesitter.c coverage ==="
    lcov --list --rc branch_coverage=1 lcov.info

lines mod:
    @awk '/^DA:/ && /,0$/ {gsub(/DA:|,0/,""); print $0}' lcov.info \
    | sort -n | while read ln; do echo "L$ln: $(sed -n ${ln}p {{ mod }}.c)"; done

pt-lines: (lines "piecetab")
cg-lines: (lines "cellgrid")
tf-lines: (lines "termfeed")
ts-lines: (lines "treesitter")
sp-lines: (lines "spantree")
sp-unbranched: (cov-unbranched "spantree")

clean: clean-gcda
    rm -f *.so luajit/*.so *.gcda luajit/*.gcda lua_coverage.info lcov.info
