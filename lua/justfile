# lua bindings: build, test, coverage. CWD = lua/ (just lua/<recipe> sets it)
# run from repo root: just lua/<name> | just lua/<name>-cov | just lua/<name>-lines | just lua/clean

import '../build.just'
MODULE := "lua"

INCS := "-I. -Ilua"

# build a PUC Lua module
build mod: root (lua-build mod + ".c" INCS LUA_INC mod + ".so" "-DNDEBUG -O2")
# build a LuaJIT Lua module
build-jit mod: root (lua-build mod + ".c" INCS LUAJIT_INC "luajit/" + mod + ".so" "-DNDEBUG -O2")
# build both PUC and LuaJIT modules
build-both mod: root (build mod) (build-jit mod)
# build vendored lua-utf8 for PUC Lua
build-utf8: root (lua-build "lutf8lib.c" INCS LUA_INC "lua-utf8.so" "-DNDEBUG -O2")
# build vendored lua-utf8 for LuaJIT
build-utf8-jit: root (lua-build "lutf8lib.c" INCS LUAJIT_INC "luajit/lua-utf8.so" "-DNDEBUG -O2")
# debug + ASan build of a binding module; output stays {{mod}}.so so Lua can require it
dbg mod: root (lua-build mod + ".c" INCS LUA_INC mod + ".so" "-g -O0 -fno-omit-frame-pointer -fsanitize=address,undefined")

# run a Lua test file under both PUC Lua and LuaJIT
run t *args='':
    lua tests/{{ t }}.lua {{ args }}
    luajit tests/{{ t }}.lua {{ args }}

# piecetab binding tests
pt *args='': root (build-both "piecetab") (run "piecetab_test" args)
# cellgrid binding tests
cg *args='': root (build-both "cellgrid") (run "cellgrid_test" args)
# termfeed binding tests
tf *args='': root (build-both "termfeed") (run "termfeed_test" args)
# json binding tests
json *args='': root (build-both "json") (run "json_test" args)
# build lua-utf8 for both PUC and LuaJIT
utf8: root build-utf8 build-utf8-jit
# lsp binding tests
lsp *args='': root (build-both "piecetab") (build-both "json") utf8 (run "lsp_test" args)
# spantree binding tests
sp *args='': root (build-both "spantree") (run "spantree_test" args)
# textmatch binding tests
tm *args='': root (build-both "piecetab") (build-both "textmatch") (run "textmatch_test" args)

# build the PUC Lua modules needed for the editor demo (tree-sitter optional)
deps: root deps-lua deps-jit
# build PUC Lua modules for the editor demo
deps-lua: root (build "piecetab") (build "cellgrid") (build "termfeed") (build "json") (build "spantree") (build "textmatch") build-utf8
# build LuaJIT modules for the editor demo
deps-jit: root (build-jit "piecetab") (build-jit "cellgrid") (build-jit "termfeed") (build-jit "json") (build-jit "spantree") (build-jit "textmatch") build-utf8-jit

# editor demo unit tests (builds required C modules)
ed *args='': root deps-lua
    lua tests/editor_test.lua {{ args }}
# editor display tests via tmux (builds required C modules)
ed-tmux *args='': root deps-lua
    lua tests/editor_tmux_test.lua {{ args }}

# fetch tree-sitter grammars (optional)
ts-grammars *langs='c lua': root
    sh "$ROOT/misc/fetch_grammars.sh" {{ langs }}

# build tree-sitter binding for PUC and LuaJIT
build-ts: root ts-grammars (lua-build "treesitter.c" INCS LUA_INC "treesitter.so" "-DNDEBUG -O2 " + TS_INC TS_LIB) (lua-build "treesitter.c" INCS LUAJIT_INC "luajit/treesitter.so" "-DNDEBUG -O2 " + TS_INC TS_LIB)

# build only the PUC Lua tree-sitter binding (used by macOS CI)
build-ts-puc: ts-grammars (lua-build "treesitter.c" INCS LUA_INC "treesitter.so" "-DNDEBUG -O2 " + TS_INC TS_LIB)

# treesitter binding tests
ts *args='': root build-ts (run "treesitter_test" args)

# run every test suite (needs lua-utf8 rock, tmux, tree-sitter grammars)
test: root pt cg tf json lsp ed ed-tmux ts sp tm

# piecetab binding coverage
pt-cov: root (lua-cov-run "piecetab" "piecetab_test" INCS)
# cellgrid binding coverage
cg-cov: root (lua-cov-run "cellgrid" "cellgrid_test" INCS)
# termfeed binding coverage
tf-cov: root (lua-cov-run "termfeed" "termfeed_test" INCS)
# spantree binding coverage
sp-cov: root (lua-cov-run "spantree" "spantree_test" INCS)
# textmatch binding coverage
tm-cov: root (build-both "piecetab") (lua-cov-run "textmatch" "textmatch_test" INCS)
# json binding coverage
json-cov: root (lua-cov-run "json" "json_test" INCS)
# treesitter binding coverage
ts-cov: root (lua-cov-run "treesitter" "treesitter_test" INCS + " " + TS_INC TS_LIB)

[private]
lines mod:
    @awk '/^DA:/ && /,0$/ {gsub(/DA:|,0/,""); print $0}' lcov.info \
    | sort -n | while read ln; do echo "L$ln: $(sed -n ${ln}p {{ mod }}.c)"; done

# piecetab uncovered lines
pt-lines: (lines "piecetab")
# cellgrid uncovered lines
cg-lines: (lines "cellgrid")
# termfeed uncovered lines
tf-lines: (lines "termfeed")
# treesitter uncovered lines
ts-lines: (lines "treesitter")
# spantree uncovered lines
sp-lines: (lines "spantree")
# spantree uncovered branches
sp-unbranched: (cov-unbranched "spantree")

# remove Lua coverage artifacts
clean-gcda:
    -just rm-gcda "."
    -just rm-gcda "luajit"

# remove generated Lua modules and coverage artifacts
clean: clean-gcda
    -rm -fr *.dSYM grammar luajit
    -rm -f *.so luajit/*.so lua_coverage.info lcov.info
    -rm -f *.so *.dll *.exp *.lib
    -rm -f luajit/*.so luajit/*.dll luajit/*.exp luajit/*.lib
