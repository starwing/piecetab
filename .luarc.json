{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "workspace.library": [
        "lua/piecetab.d.lua",
        "lua/cellgrid.d.lua",
        "lua/termfeed.d.lua",
        "lua/lua-utf8.d.lua",
        "lua/treesitter.d.lua",
        "lua/spantree.d.lua",
        "lua/tests/luaunit.lua",
        "lua/tests/serpent.lua"
    ],
    "runtime.path": [
        "?.lua",
        "lua/?.lua",
        "lua/tests/?.lua"
    ],
    "runtime.version": "Lua 5.4",
    "diagnostics.libraryFiles": "Disable",
    "diagnostics.ignoredFiles": "Disable",
    "workspace.ignoreDir": [
        "lua/tests/luaunit.lua"
    ],
    "diagnostics": {
        "disable": [
            "redefined-local",
            "unused-local"
        ]
    }
}