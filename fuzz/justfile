import '../build.just'
MODULE := "fuzz"

INCS := "-Ifuzz -I. -Itests"

# fuzz: seeded random-op stress with per-op invariant checks
sp seed='1': root (fuzz-run "sp" INCS seed)
# fuzz: seeded random-op stress with per-op invariant checks
pt seed='1': root (fuzz-run "pt" INCS seed)
# fuzz: seeded random-op stress with per-op invariant checks
lc seed='1': root (fuzz-run "lc" INCS seed)
# replay a recorded op log
replay lib path: root (fuzz-run lib INCS "replay" path)
# debug fuzz: ASan/UBSan build, precise fault isolation
sp-dbg seed='1': root (dfz-run "sp" INCS seed)
# debug fuzz: ASan/UBSan build, precise fault isolation
pt-dbg seed='1': root (dfz-run "pt" INCS seed)
# debug fuzz: ASan/UBSan build, precise fault isolation
lc-dbg seed='1': root (dfz-run "lc" INCS seed)
# remove fuzz binaries
clean:
    -rm -f *_fuzz *_fuzz_dbg *_replay
